// Prisma Schema for ShikshaLokam App
// Note: Requires Node.js 20.19+ for Prisma to work
// Database: PostgreSQL with pgvector extension

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String    @unique @map("clerk_user_id")
  email         String    @unique
  name          String?
  subjects      String[]  @default([])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  queries       Query[]
  lessonPlans   LessonPlan[]
  escalations   Escalation[]

  @@map("users")
}

model Query {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  originalText    String    @map("original_text") @db.Text
  voiceTranscript String?   @map("voice_transcript") @db.Text
  responseType    String?   @map("response_type")
  aiResponse      String?   @map("ai_response") @db.Text
  sourcesUsed     Json?     @map("sources_used")
  isRelevant      Boolean?  @map("is_relevant")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  escalations     Escalation[]
  analytics       Analytics?

  @@index([userId])
  @@index([createdAt])
  @@map("queries")
}

model LessonPlan {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  fileName      String    @map("file_name")
  fileUrl       String    @map("file_url")
  fileSize      Int       @map("file_size")
  tags          String[]
  metadata      Json?
  extractedText String?   @map("extracted_text") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[] @relation("LessonPlanChunks")

  @@index([userId])
  @@index([createdAt])
  @@map("lesson_plans")
}

model KnowledgeBaseDocument {
  id            String    @id @default(uuid())
  fileName      String    @map("file_name")
  fileUrl       String    @map("file_url")
  documentType  String    @map("document_type")
  tags          String[]
  extractedText String?   @map("extracted_text") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  chunks        DocumentChunk[] @relation("KnowledgeBaseChunks")

  @@map("knowledge_base_documents")
}

model DocumentChunk {
  id            String    @id @default(uuid())
  documentId    String    @map("document_id")
  documentType  String    @map("document_type") // "knowledge_base" or "lesson_plan"
  chunkText     String    @map("chunk_text") @db.Text
  chunkIndex    Int       @map("chunk_index")
  embedding     Unsupported("vector")? // pgvector type
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  lessonPlan    LessonPlan?           @relation("LessonPlanChunks", fields: [documentId], references: [id], onDelete: Cascade, map: "document_chunks_lesson_plan_fkey")
  knowledgeBase KnowledgeBaseDocument? @relation("KnowledgeBaseChunks", fields: [documentId], references: [id], onDelete: Cascade, map: "document_chunks_knowledge_base_fkey")

  @@index([documentId])
  @@index([documentType])
  @@map("document_chunks")
}

model Escalation {
  id          String    @id @default(uuid())
  queryId     String    @map("query_id")
  userId      String    @map("user_id")
  status      String    @default("pending")
  emailSent   Boolean   @default(false) @map("email_sent")
  emailSentAt DateTime? @map("email_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  query       Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([userId])
  @@index([status])
  @@map("escalations")
}

model Analytics {
  id            String    @id @default(uuid())
  queryId      String    @unique @map("query_id")
  responseTimeMs Int     @map("response_time_ms")
  responseType String    @map("response_type")
  topics       String[]
  createdAt    DateTime  @default(now()) @map("created_at")

  query        Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("analytics")
}

